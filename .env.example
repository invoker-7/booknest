# ---------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ถูก ignore ไว้แล้ว ห้าม commit ขึ้น GitHub
# ---------------------------------------------------------

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# secret key (service_role) — ใช้บน server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# publishable key (ชื่อเดิม anon key) — ใช้ที่ server สำหรับ session ของสมาชิก
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# อีเมลผู้ดูแลระบบ (เข้า /admin ได้) คั่นหลายคนด้วย ,
ADMIN_EMAILS=you@example.com

# ตั้งเป็น true หลังเปิด Google provider ใน Supabase > Authentication > Providers
# เข้าสู่ระบบได้ทางเดียวคือ Google — ถ้าเป็น false จะไม่มีใครล็อกอินได้
AUTH_GOOGLE_ENABLED=false

# ชื่อ bucket ที่เก็บไฟล์ e-book (ตั้งเป็น private)
SUPABASE_EBOOK_BUCKET=ebooks

# Gmail SMTP — เปิด 2-Step Verification แล้วสร้าง App Password
# ใช้ส่งลิงก์ดาวน์โหลดและรหัส OTP ตอนเข้าสู่ระบบ (เว้นว่างตอน dev = รหัส OTP แสดงใน log ของ server)
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx


# ต้องเป็นอีเมลเดียวกับ SMTP_USER หรือชื่อผู้ส่งที่ Gmail อนุญาต
EMAIL_FROM=BookNest <your.gmail@gmail.com>
