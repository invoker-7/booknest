# ---------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ถูก ignore ไว้แล้ว ห้าม commit ขึ้น GitHub
# ---------------------------------------------------------

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# secret key (service_role) — ใช้บน server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# publishable key (ชื่อเดิม anon key) — ใช้ที่ server สำหรับ session ของสมาชิก
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# อีเมลผู้ดูแลระบบ (เข้า /admin ได้) คั่นหลายคนด้วย ,
ADMIN_EMAILS=you@example.com

# ตั้งเป็น true หลังเปิด Google provider ใน Supabase > Authentication > Providers
# เข้าสู่ระบบได้ทางเดียวคือ Google — ถ้าเป็น false จะไม่มีใครล็อกอินได้
AUTH_GOOGLE_ENABLED=false

# ชื่อ bucket ที่เก็บไฟล์ e-book (ตั้งเป็น private)
SUPABASE_EBOOK_BUCKET=ebooks

# Gmail SMTP — เปิด 2-Step Verification แล้วสร้าง App Password
# ใช้ส่งลิงก์ดาวน์โหลดและรหัส OTP ตอนเข้าสู่ระบบ (เว้นว่างตอน dev = รหัส OTP แสดงใน log ของ server)
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx


# ต้องเป็นอีเมลเดียวกับ SMTP_USER หรือชื่อผู้ส่งที่ Gmail อนุญาต
EMAIL_FROM=BookNest <your.gmail@gmail.com>

# ---------- การชำระเงิน ----------
# ตั้งได้ทั้งสองช่องทางพร้อมกัน: ผู้ซื้อจะเลือกเองตอนชำระเงิน ตั้งช่องทางเดียวก็ใช้ช่องทางนั้น
#
# Stripe Checkout — ผู้ซื้อจ่ายด้วยบัตรหรือ QR พร้อมเพย์บนหน้าของ Stripe ระบบยืนยันเองและส่งไฟล์ทันที (ไม่มีสลิป)
# Secret key จาก https://dashboard.stripe.com > Developers > API keys
#   sk_test_... = โหมดทดสอบ ไม่มีเงินจริง ใช้บัตร 4242 4242 4242 4242 ได้   sk_live_... = รับเงินจริง (ต้องยืนยันตัวตนกับ Stripe)
STRIPE_SECRET_KEY=
# (แนะนำ) Signing secret ของ webhook — เพิ่มปลายทาง https://<โดเมน>/api/stripe/webhook ใน Developers > Webhooks
# เลือกเหตุการณ์ checkout.session.completed และ checkout.session.async_payment_succeeded
# ไม่ตั้งก็ใช้งานได้ แต่ถ้าผู้ซื้อปิดหน้าต่างก่อนถูกพากลับมา ระบบจะไม่รู้ว่าจ่ายแล้วจนกว่าร้านกดยืนยันเอง
STRIPE_WEBHOOK_SECRET=

# QR พร้อมเพย์ของร้านเอง — เบอร์มือถือ 10 หลัก หรือเลขประจำตัว 13 หลักที่ผูกพร้อมเพย์ไว้
# ยอดที่ต่ำกว่าขั้นต่ำของ Stripe (10 บาท) ใช้ช่องทางนี้เสมอ
# ผู้ซื้อสแกนจ่าย (เงินเข้าบัญชีที่ผูกไว้โดยตรง) แล้วเจ้าของร้านกด "ยืนยันรับเงิน" ที่ /admin/orders ระบบจึงส่งไฟล์
# ถ้าเว้นว่าง: บน production ปิดการสั่งซื้อ ส่วน pnpm dev ในเครื่องใช้การชำระเงินแบบจำลองเพื่อทดสอบ
PROMPTPAY_ID=

# ตรวจสลิปโอนเงินอัตโนมัติ (ไม่บังคับ) — API key จาก https://developer.easyslip.com
# ตั้งแล้ว: ลูกค้าแนบสลิปที่ถูกต้อง ระบบยืนยันการชำระและส่งไฟล์ให้ทันที ไม่ต้องรอร้านกดยืนยัน
# ต้องลงทะเบียนบัญชีรับเงินของร้านในหน้าจัดการของ EasySlip ด้วย และอย่าเปิด IP whitelist (Vercel ไม่มี IP ตายตัว)
# ไม่ตั้ง: ร้านตรวจสลิปเองที่ /admin/orders เหมือนเดิม
EASYSLIP_API_KEY=
